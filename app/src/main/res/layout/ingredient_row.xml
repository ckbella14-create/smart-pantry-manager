<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation ="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding = "12dp"
    android:background="@drawable/pantry_item_background">

    <!--shows/displays ingredient name-->
    <TextView
        android:id = "@+id/ingredientNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text = "Ingredient Name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#075E68" />

    <!--ingredient qty and unit-->
    <TextView
        android:id = "@+id/quantityTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text = "Quantity: 2kg"
        android:textSize="14sp"
        android:textColor="#075E68" />

    <!--expiry date -->
    <TextView
        android:id = "@+id/expiryDateTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text = "Expiry Date: 2026-09-20"
        android:textSize="14sp"
        android:textColor="#075E68" />

    <!--buttons to edit or delete ingredient-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/editIngredientButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#E0E0E0"
            android:text="Edit"
            android:textColor="#075E68"
            android:textSize="12sp" />

        <Button
            android:id="@+id/deleteIngredientButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#E0E0E0"
            android:text="Delete"
            android:textColor="#075E68"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>